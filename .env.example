# ==============================================================================
# WEATHER FORECAST & ALERT APPLICATION - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your real API key (NEVER commit .env to GitHub!)

# Weather API Provider: 'openweathermap' or 'weatherapi'
WEATHER_PROVIDER=openweathermap

# OpenWeatherMap API Key (Free tier at https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# WeatherAPI Key (Alternative free tier at https://www.weatherapi.com/)
WEATHERAPI_KEY=your_weatherapi_key_here

# Default City Configuration
DEFAULT_CITY=Mumbai
DEFAULT_UNITS=metric

# Risk Alert Threshold Configurations (Customizable Defaults)
ALERT_TEMP_HIGH_C=38.0       # Trigger heat alert above this (°C)
ALERT_TEMP_LOW_C=4.0         # Trigger frost/cold alert below this (°C)
ALERT_RAIN_MM=10.0           # Trigger heavy rain alert above this (mm)
ALERT_WIND_KMH=40.0          # Trigger gale alert above this (km/h)
ALERT_HUMIDITY_PERCENT=85.0  # Trigger excessive humidity alert above this (%)
ALERT_AQI_PM25=100.0         # Air Quality Hazard threshold

# Simulation Mode: set to true to force offline synthetic data simulation
FORCE_SIMULATION_MODE=false
